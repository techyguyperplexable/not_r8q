&soc {
	msm_bus: qcom,kgsl-busmon {
		label = "kgsl-busmon";
		compatible = "qcom,kgsl-busmon";
		operating-points-v2 = <&gpu_opp_table_v2>;
	};

	gpu_opp_table_v2: gpu-opp-table_v2 {
		compatible = "operating-points-v2";

		opp-831491840 {
			opp-hz = /bits/ 64 <831491840>;
                       opp-microvolt = <265>;
		};

		opp-768790912 {
			opp-hz = /bits/ 64 <768790912>;
                       opp-microvolt = <256>;
		};

		opp-629006528 {
			opp-hz = /bits/ 64 <629006528>;
                       opp-microvolt = <201>;
		};

		opp-499957760 {
			opp-hz = /bits/ 64 <499957760>;
                       opp-microvolt = <84>;
		};
		
		opp-421527168 {
			opp-hz = /bits/ 64 <421527168>;
                       opp-microvolt = <16>;
		};
	};
};

&msm_gpu {
	qcom,chipid = <0x06050001>;

	/* GPU OPP data */
	operating-points-v2 = <&gpu_opp_table_v2>;

	/delete-property/qcom,initial-pwrlevel;
	/delete-node/qcom,gpu-pwrlevels;

	/* Power levels bins */
	qcom,gpu-pwrlevel-bins {
		compatible="qcom,gpu-pwrlevel-bins";
		#address-cells = <1>;
		#size-cells = <0>;

		qcom,gpu-pwrlevels-0 {
			#address-cells = <1>;
			#size-cells = <0>;
			qcom,speed-bin = <0>;
			qcom,initial-pwrlevel = <4>;
			qcom,throttle-pwrlevel = <0>;


                        qcom,gpu-pwrlevel@0 {
                                reg = <0>;
                                qcom,gpu-freq = <831491840>;
                                
                                qcom,bus-freq-ddr7 = <12>;                         
                                qcom,bus-freq-ddr8 = <12>;
                                
                                qcom,acd-level = <0x882f5ffd>;
                        };

                        qcom,gpu-pwrlevel@1 {
                                reg = <1>;
                                qcom,gpu-freq = <768790912>;
                                
                                qcom,bus-freq-ddr7 = <12>;                       
                                qcom,bus-freq-ddr8 = <11>;
                                
                                qcom,acd-level = <0xc0285ffd>;
                        };
                        
                        qcom,gpu-pwrlevel@2 {
                                reg = <2>;
                                qcom,gpu-freq = <629006528>;
                                
                                qcom,bus-freq-ddr7 = <11>; 
                                qcom,bus-freq-ddr8 = <11>;
                                
                                qcom,acd-level = <0xc02a5ffd>;
                        };
                        
                        qcom,gpu-pwrlevel@3 {
                                reg = <3>;
                                qcom,gpu-freq = <499957760>;
                                
                                qcom,bus-freq-ddr7 = <9>;                             
                                qcom,bus-freq-ddr8 = <9>;
                                
                                qcom,acd-level = <0xc02c5ffd>;
                        };

			qcom,gpu-pwrlevel@4 {
				reg = <4>;
				qcom,gpu-freq = <421527168>;
					
				qcom,bus-freq-ddr7 = <5>;
				qcom,bus-freq-ddr8 = <5>;
				
				qcom,acd-level = <0xc02f5ffd>;
			};

			qcom,gpu-pwrlevel@5 {
				reg = <5>;
				qcom,gpu-freq = <0>;
				qcom,bus-freq = <0>;
				qcom,bus-min = <0>;
				qcom,bus-max = <0>;
			};
		};
	};
};
