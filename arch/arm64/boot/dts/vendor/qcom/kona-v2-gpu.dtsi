&soc {
	msm_bus: qcom,kgsl-busmon {
		label = "kgsl-busmon";
		compatible = "qcom,kgsl-busmon";
		operating-points-v2 = <&gpu_opp_table_v2>;
	};

	gpu_opp_table_v2: gpu-opp-table_v2 {
		compatible = "operating-points-v2";

		opp-868778688 {
			opp-hz = /bits/ 64 <868778688>;
			opp-microvolt = <275>;
		};

		opp-831790080 {
			opp-hz = /bits/ 64 <831790080>;
                       opp-microvolt = <265>;
		};

		opp-768786048 {
			opp-hz = /bits/ 64 <768786048>;
                       opp-microvolt = <256>;
		};

		opp-718921728 {
			opp-hz = /bits/ 64 <718921728>;
                       opp-microvolt = <245>;
		};

		opp-680173568 {
			opp-hz = /bits/ 64 <680173568>;
                       opp-microvolt = <239>;
		};

		opp-628748736 {
			opp-hz = /bits/ 64 <628748736>;
                       opp-microvolt = <227>;
		};

		opp-576521088 {
			opp-hz = /bits/ 64 <576521088>;
                       opp-microvolt = <196>;
		};

		opp-498073344 {
			opp-hz = /bits/ 64 <498073344>;
                       opp-microvolt = <164>;
		};

		opp-421108608 {
			opp-hz = /bits/ 64 <421108608>;
                       opp-microvolt = <32>;
		};
	};
};

&msm_gpu {
	qcom,chipid = <0x06050001>;

	/* GPU OPP data */
	operating-points-v2 = <&gpu_opp_table_v2>;

	/delete-property/qcom,initial-pwrlevel;
	/delete-node/qcom,gpu-pwrlevels;

	/* Power levels bins */
	qcom,gpu-pwrlevel-bins {
		compatible="qcom,gpu-pwrlevel-bins";
		#address-cells = <1>;
		#size-cells = <0>;

		qcom,gpu-pwrlevels-0 {
			#address-cells = <1>;
			#size-cells = <0>;
			qcom,speed-bin = <0>;
			qcom,initial-pwrlevel = <8>;
			qcom,throttle-pwrlevel = <0>;

                        qcom,gpu-pwrlevel@0 {
                                qcom,acd-level = <0x882f5ffd>;
                                qcom,gpu-freq  = <868778688>;
                                qcom,bus-freq-ddr7 = <12>;
                                qcom,bus-freq-ddr8 = <12>;
				reg = <0>;
                        };

                        qcom,gpu-pwrlevel@1 {
                                qcom,acd-level = <0xc0285ffd>;
                                qcom,gpu-freq  = <831790080>;
                                qcom,bus-freq-ddr7 = <12>;
                                qcom,bus-freq-ddr8 = <12>;
				reg = <1>;
                        };

                        qcom,gpu-pwrlevel@2 {
                                qcom,acd-level = <0xe0295ffd>;
                                qcom,gpu-freq  = <768786048>;
                                qcom,bus-freq-ddr7 = <12>;
                                qcom,bus-freq-ddr8 = <11>;
				reg = <2>;
                        };

			qcom,gpu-pwrlevel@3 {
				qcom,acd-level = <0xe0295ffd>;
				qcom,gpu-freq  = <718921728>;
                                qcom,bus-freq-ddr7 = <11>;
                                qcom,bus-freq-ddr8 = <11>;
				reg = <3>;
			};
				
			qcom,gpu-pwrlevel@4 {
				qcom,acd-level = <0xc02a5ffd>;
				qcom,gpu-freq  = <680173568>;
				qcom,bus-freq-ddr7 = <11>;
				qcom,bus-freq-ddr8 = <11>;
				reg = <4>;
			};
			
			qcom,gpu-pwrlevel@5 {
				qcom,acd-level = <0xc02a5ffd>;
				qcom,gpu-freq  = <628748736>;
				qcom,bus-freq-ddr7 = <11>;
				qcom,bus-freq-ddr8 = <11>;
				reg = <5>;
			};
			
			qcom,gpu-pwrlevel@6 {
				qcom,acd-level = <0xc02a5ffd>;
				qcom,gpu-freq  = <576521088>;
				qcom,bus-freq-ddr7 = <11>;
				qcom,bus-freq-ddr8 = <11>;
				reg = <6>;
			};
			
			qcom,gpu-pwrlevel@7 {		
				qcom,acd-level = <0xc82c5ffd>;
				qcom,gpu-freq  = <498073344>;
				qcom,bus-freq-ddr7 = <10>;
				qcom,bus-freq-ddr8 = <9>;
				reg = <7>;
			};

			qcom,gpu-pwrlevel@8 {
				qcom,acd-level = <0xc82c5ffd>;
				qcom,gpu-freq  = <421108608>;
				qcom,bus-freq-ddr7 = <7>;
				qcom,bus-freq-ddr8 = <6>;
				reg = <8>;
			};

			qcom,gpu-pwrlevel@9 {
			        qcom,gpu-freq = <0>;
				qcom,bus-freq = <0>;
				qcom,bus-min = <0>;
				qcom,bus-max = <0>;
				reg = <9>;
			};
		};
	};
};
